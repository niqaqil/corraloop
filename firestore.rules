rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidProfile(data) {
      return data.size() >= 4 &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.city is string && data.city.size() > 0 && data.city.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidCommunity(data) {
      return data.size() >= 5 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.city is string && data.city.size() > 0 && data.city.size() <= 100 &&
             data.createdBy == request.auth.uid &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidMembership(data) {
      return data.size() >= 4 &&
             data.userId == request.auth.uid &&
             data.communityId is string && data.communityId.size() > 0 &&
             (data.role == 'member' || data.role == 'organizer') &&
             data.joinedAt is timestamp && data.joinedAt <= request.time;
    }

    function isValidRun(data) {
      return data.size() >= 9 &&
             data.communityId is string && data.communityId.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.meetingLat is number &&
             data.meetingLng is number &&
             data.startsAt is timestamp &&
             data.checkinOpensAt is timestamp &&
             data.checkinClosesAt is timestamp &&
             data.checkinOpensAt < data.startsAt &&
             data.checkinClosesAt > data.startsAt &&
             data.createdBy == request.auth.uid &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidCheckin(data, runId) {
      return data.size() >= 6 &&
             data.runId == runId &&
             data.userId == request.auth.uid &&
             data.accuracyM is number && data.accuracyM <= 50.0 &&
             data.lat is number &&
             data.lng is number &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidProfile(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidCommunity(request.resource.data);
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    match /memberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidMembership(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /runs/{runId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidRun(request.resource.data);
      allow update: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    match /checkins/{checkinId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    checkinId == (request.resource.data.runId + '_' + request.auth.uid) &&
                    isValidCheckin(request.resource.data, request.resource.data.runId);
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
